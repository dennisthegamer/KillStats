{
	"schemaVersion": 1,
	"id": "killstats",
	"version": "${version}",
	"name": "KillStats",
	"description": "Tracks mob kills per session, estimates drop value in Emeralds, and displays live stats in a configurable HUD overlay.",
	"authors": [
		"Dennis_thegamer"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/killstats",
		"issues": "https://github.com/DennisTheGamer/KillStats/issues"
	},
	"license": "MIT",
	"icon": "assets/killstats/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"de.dennisthegamer.killstats.KillStatsClient"
		],
		"modmenu": [
			"de.dennisthegamer.killstats.config.ModMenuIntegration"
		]
	},
	"mixins": [
		"killstats.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.2-",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": ">=20.0.0-beta.3",
		"yet_another_config_lib": ">=3.9.4"
	}
}
